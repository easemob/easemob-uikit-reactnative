{
  "name": "react-native-chat-uikit",
  "version": "2.4.8",
  "description": "react native chat uikit.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\"",
    "clean": "yarn clean:generated && yarn clean:build && yarn clean:lib",
    "clean:generated": "del-cli ios/generated android/generated",
    "clean:build": "del-cli android/build",
    "clean:lib": "del-cli lib",
    "clean:node_modules": "del-cli node_modules",
    "prepare": "yarn gen && yarn lib",
    "lib": "bob build",
    "gen": "yarn gen:config && yarn gen:rename && yarn gen:version",
    "gen:config": "node ./scripts/generate-config.js",
    "gen:rename": "node ./scripts/generate-rename.js",
    "gen:version": "node ./scripts/generate-version.js",
    "generate-bundle": "node scripts/bundle-icons.js",
    "change-icon-name": "node scripts/change-icons-name.js",
    "generate-face-name": "node scripts/generate-faces-name.js",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/easemob/easemob-uikit-reactnative",
  "author": "Asterisk <zuoyu@easemob.com> (https://github.com/asteriskzuo)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/easemob/easemob-uikit-reactnative/issues"
  },
  "homepage": "https://github.com/easemob/easemob-uikit-reactnative#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-camera-roll/camera-roll": "^7.10.0",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-native-community/cli": "15.0.1",
    "@react-native-documents/picker": "^10.1.2",
    "@react-native/eslint-config": "^0.73.1",
    "@release-it/conventional-changelog": "^9.0.2",
    "@types/jest": "^29.5.5",
    "@types/react": "^18.2.44",
    "commitlint": "^17.0.2",
    "del-cli": "^5.1.0",
    "eslint": "^8.1.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "^29.7.0",
    "prettier": "~3.5.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-audio-recorder-player": "^3.6.12",
    "react-native-builder-bob": "^0.36.0",
    "react-native-chat-sdk": "^1.11.5",
    "react-native-create-thumbnail": "^2.1.1",
    "react-native-device-info": "^14.0.4",
    "react-native-file-access": "^3.1.1",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-image-picker": "^8.2.0",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-video": "^6.11.0",
    "release-it": "^17.10.0",
    "typescript": "^5.2.2"
  },
  "resolutions": {
    "@types/react": "^18.2.44"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "@react-native-camera-roll/camera-roll": "*",
    "@react-native-clipboard/clipboard": "*",
    "@react-native-documents/picker": "*",
    "react": "*",
    "react-native": ">=0.71.0",
    "react-native-audio-recorder-player": "*",
    "react-native-chat-sdk": "^1.8.0",
    "react-native-create-thumbnail": "*",
    "react-native-device-info": "*",
    "react-native-file-access": "*",
    "react-native-gesture-handler": "*",
    "react-native-image-picker": "*",
    "react-native-safe-area-context": "*",
    "react-native-video": "*"
  },
  "packageManager": "yarn@4.9.1",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "simple-import-sort"
    ],
    "parserOptions": {
      "requireConfigFile": false
    },
    "rules": {
      "react/react-in-jsx-scope": "off",
      "simple-import-sort/imports": "error",
      "simple-import-sort/exports": "error",
      "react-native/no-inline-styles": "off",
      "@typescript-eslint/no-shadow": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "scripts/",
    "babel.config.js",
    "react-native.config.js"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNChatUikitSpec",
    "type": "modules",
    "jsSrcsDir": "src/__native__",
    "android": {
      "javaPackageName": "com.chatuikit"
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "version": "0.48.3"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "pinyin-pro": "^3.26.0",
    "pure-uuid": "^1.8.1",
    "twemoji": "^14.0.2"
  }
}
