{
  "name": "react-native-chat-room",
  "version": "1.0.4-beta.0",
  "description": "react native chat room",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "echo typecheck start && tsc && echo typecheck end",
    "lintcheck": "echo lint start && eslint \"src/**/*.{js,ts,tsx}\" && echo lint end",
    "circular-dep-check": "madge --circular --extensions ts,tsx src",
    "clean": "yarn clean:generated && yarn clean:build && yarn clean:lib",
    "clean:generated": "del-cli ios/generated android/generated",
    "clean:build": "del-cli android/build",
    "clean:lib": "del-cli lib",
    "prepare": "yarn gen && yarn lib",
    "lib": "bob build",
    "gen": "yarn gen:config && yarn gen:rename && yarn gen:version",
    "gen:config": "node ./scripts/generate-config.js",
    "gen:rename": "node ./scripts/generate-rename.js",
    "gen:version": "node ./scripts/generate-version.js",
    "generate-bundle": "node scripts/bundle-icons.js",
    "change-icon-name": "node scripts/change-icons-name.js",
    "generate-face-name": "node scripts/generate-faces-name.js",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easemob/easemob-room-reactnative.git"
  },
  "author": "asteriskzuo <zuoyuhsywn@hotmail.com> (https://github.com/easemob)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/easemob/easemob-room-reactnative/issues"
  },
  "homepage": "https://github.com/easemob/easemob-room-reactnative#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.83.2",
    "@react-native/eslint-config": "0.83.2",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/react": "^19.2.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.5.3",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-builder-bob": "^0.40.18",
    "react-native-chat-sdk": "^1.12.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "~5.6.0",
    "release-it": "^19.0.4",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0",
    "react-native-chat-sdk": "^1.12.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-linear-gradient": ">=3.0.0",
    "react-native-safe-area-context": ">=5.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ChatRoomViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.chatroom"
    },
    "ios": {
      "components": {
        "ChatRoomView": {
          "className": "ChatRoomView"
        }
      }
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.57.2"
  },
  "dependencies": {
    "twemoji": "^14.0.2"
  }
}
