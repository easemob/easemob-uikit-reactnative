{
  "expo": {
    "name": "ChatUikitExample",
    "slug": "ChatUikitExample",
    "scheme": "expodemowithdevclient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/a0a89c08-ad6f-4d18-8c61-3c2385c981e6"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hyphenate.rn.ChatUikitExample",
      "infoPlist": {
        "NSCameraUsageDescription": "Use camera for taking photos and videos in chat.",
        "NSMicrophoneUsageDescription": "Use microphone for recording voice messages in chat.",
        "NSPhotoLibraryUsageDescription": "Use picture gallery for sharing images in chat.",
        "NSAppleMusicUsageDescription": "Use the media library for sharing media files in chat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.hyphenate.rn.ChatUikitExample",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "a0a89c08-ad6f-4d18-8c61-3c2385c981e6"
      }
    },
    "runtimeVersion": "1.0.0",
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Camera",
            "PhotoLibrary",
            "Microphone",
            "MediaLibrary"
          ],
          "androidPermissions": [
            "android.permission.CAMERA",
            "android.permission.READ_EXTERNAL_STORAGE",
            "android.permission.WRITE_EXTERNAL_STORAGE",
            "android.permission.RECORD_AUDIO"
          ]
        }
      ],
      "react-native-video"
    ],
    "newArchEnabled": true,
    "jsEngine": "hermes"
  }
}
