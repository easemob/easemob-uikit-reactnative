{
  "name": "uikit-example",
  "main": "./index.js",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "startr": "expo start --dev-client --clear",
    "prepare": "yarn expo:prebuild && yarn gen",
    "expo:prebuild": "expo prebuild --clean --no-install",
    "update:arch": "node scripts/update-arch-config.js",
    "clean": "yarn clean:build",
    "clean:build": "del-cli ios/build ios/Pods android/build android/app/build android/app/.cxx",
    "gen": "yarn gen:env && yarn gen:rename",
    "gen:env": "node scripts/generate-env.js",
    "gen:rename": "node scripts/generate-rename.js",
    "lintcheck": "echo lint start && eslint \"src/**/*.{js,jsx,ts,tsx}\" && echo lint end",
    "circular-dep-check": "madge --circular --extensions ts,tsx src",
    "typecheck": "echo typecheck start && tsc --noEmit && echo typecheck end",
    "eas-build-pre-install": "sh ./scripts/eas-build-pre-install.sh",
    "eas-build-post-install": "sh ./scripts/eas-build-post-install.sh"
  },
  "dependencies": {
    "@expo/log-box": "~55.0.7",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-camera-roll/camera-roll": "^7.10.0",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/image-editor": "^4.3.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-documents/picker": "^10.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.3.3",
    "expo": "^55.0.0",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.10",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.8",
    "expo-image": "~55.0.5",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.0",
    "expo-splash-screen": "~55.0.9",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-web-browser": "~55.0.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-audio-recorder-player": "patch:react-native-audio-recorder-player@npm%3A3.6.14#~/.yarn/patches/react-native-audio-recorder-player-npm-3.6.14-3e27200e10.patch",
    "react-native-chat-sdk": "^1.18.0",
    "react-native-chat-uikit": "workspace:*",
    "react-native-create-thumbnail": "^2.1.1",
    "react-native-device-info": "^14.0.4",
    "react-native-file-access": "^3.1.1",
    "react-native-file-viewer": "^2.1.5",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-image-crop-picker": "^0.42.0",
    "react-native-image-picker": "^8.2.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-pager-view": "8.0.0",
    "react-native-paper": "^5.13.1",
    "react-native-permissions": "^5.3.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-tab-view": "^4.0.6",
    "react-native-video": "^6.17.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "twemoji": "^14.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "react-native-monorepo-config": "^0.3.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
