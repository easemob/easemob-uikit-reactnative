{
  "packageManager": "yarn@4.7.0",
  "name": "ChatUikitFullExample",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "startr": "expo start --clear --dev-client",
    "prepare": "yarn update:arch && yarn gen",
    "update:arch": "node scripts/update-arch-config.js",
    "clean": "yarn clean:build",
    "clean:build": "del-cli ios/build ios/Pods android/build android/app/build android/app/.cxx",
    "clean:node_modules": "del-cli node_modules",
    "gen": "yarn gen:env && yarn gen:rename",
    "gen:env": "node scripts/generate-env.js",
    "gen:rename": "node scripts/generate-rename.js",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "eas-build-pre-install": "sh ./scripts/eas-build-pre-install.sh",
    "eas-build-post-install": "sh ./scripts/eas-build-post-install.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-camera-roll/camera-roll": "^7.10.0",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/image-editor": "^4.3.0",
    "@react-native-community/slider": "4.5.5",
    "@react-native-documents/picker": "^10.1.2",
    "@react-native-firebase/app": "^21.12.3",
    "@react-native-firebase/messaging": "^21.12.3",
    "@react-navigation/native": "^7.0.19",
    "@react-navigation/native-stack": "^7.3.3",
    "expo": "~52.0.0",
    "expo-dev-client": "~5.0.14",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "expo-updates": "~0.27.4",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-agora": "~4.3.2",
    "react-native-audio-recorder-player": "^3.6.12",
    "react-native-chat-sdk": "^1.8.0",
    "react-native-create-thumbnail": "^2.1.1",
    "react-native-device-info": "^14.0.4",
    "react-native-fast-image": "^8.6.3",
    "react-native-file-access": "^3.1.1",
    "react-native-file-viewer": "^2.1.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-image-crop-picker": "^0.42.0",
    "react-native-image-picker": "^8.2.0",
    "react-native-permissions": "^5.3.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-vector-icons": "^10.2.0",
    "react-native-video": "^6.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/babel-preset": "0.76.7",
    "@react-native/eslint-config": "0.76.7",
    "@react-native/metro-config": "0.76.7",
    "@react-native/typescript-config": "0.76.7",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "del-cli": "^5.1.0",
    "eas-cli": "^15.0.15",
    "eslint": "^8.1.0",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "expo-doctor": "^1.12.8",
    "jest": "^29.6.3",
    "prettier": "^3.5.3",
    "react-native-builder-bob": "^0.36.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "plugins": [
      "simple-import-sort"
    ],
    "parserOptions": {
      "requireConfigFile": false
    },
    "rules": {
      "jest/*": 0,
      "simple-import-sort/imports": "error",
      "simple-import-sort/exports": "error",
      "react-native/no-inline-styles": 0,
      "@typescript-eslint/no-shadow": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "babel.config.js",
    "index.js",
    "jest.config.js",
    "metro.config.js",
    "react-native.config.js",
    "scripts/"
  ]
}
